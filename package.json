{
  "name": "job-autofill",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Chrome extension that fills job applications from a saved profile and stops for review",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "check": "node scripts/check-repository.mjs",
    "dev": "npm run dev -w apps/extension",
    "build": "npm run build -w apps/extension",
    "zip": "npm run zip -w apps/extension",
    "typecheck": "npm run compile -w apps/extension",
    "test": "npm test -w apps/extension",
    "test:e2e": "npm run build && playwright test"
  },
  "workspaces": [
    "apps/extension"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
